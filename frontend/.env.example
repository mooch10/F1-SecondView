# Backend API URL (dejar vacío si el frontend y el backend están en el mismo dominio)
# En producción con Vercel/Netlify, apunta a la URL de tu backend en Render/Railway:
# VITE_API_URL=https://f1-secondview-7ank.onrender.com
VITE_API_URL=http://localhost:3001

# Google Analytics 4 (GA4) - ID de medición (formato G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity - ID de proyecto (código alfanumérico)
VITE_CLARITY_PROJECT_ID=

# Google Search Console - Código del tag de verificación
VITE_GOOGLE_SITE_VERIFICATION=
